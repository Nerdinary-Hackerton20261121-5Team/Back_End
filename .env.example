PORT=3000
# 콤마로 여러 개 지정 가능. 비워두면 모든 origin 허용
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
# true면 실행 SQL을 로그로 출력
DB_LOGGING=false

# 파일 저장소(S3 호환). 운영·dev 서버는 클러스터의 RustFS(http://s3:9000)를 쓰고 값은 클러스터가 주입한다.
# 로컬에서는 비워 두면 메모리 디스크로 대신한다(재시작하면 파일이 사라짐).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# RustFS·MinIO는 true, AWS S3는 false
S3_FORCE_PATH_STYLE=true

# 이미지 변환 서버 imgproxy. 운영 https://cmc-11th.bemelon.me/img, dev https://cmc-11th-dev.bemelon.me/img
IMGPROXY_URL=
# 서명 키·솔트(hex). 서버 값은 운영자 Secret storage-auth에만 있다
IMGPROXY_KEY=
IMGPROXY_SALT=

# 제품 정책 값 (src/config/policy.ts). 비워 두면 아래 기본값. 팀 확정 전 임시값이라 환경별로 바꿀 수 있게 뺐다
# 목표 시간 범위(초)
POLICY_GOAL_MIN_SECONDS=60
POLICY_GOAL_MAX_SECONDS=14400
# heartbeat 권장 주기(초), 이 시간 넘게 신호가 없으면 끊김(초)
POLICY_HEARTBEAT_SECONDS=1
POLICY_DISCONNECT_TIMEOUT_SECONDS=90
# 방 자동 정리: 끄기(false), 주기(분), 완성 후·시작 전·미완성 종료 후 보관(분)
POLICY_CLEANUP_ENABLED=true
POLICY_CLEANUP_INTERVAL_MINUTES=10
POLICY_CLEANUP_COMPLETED_MINUTES=60
POLICY_CLEANUP_WAITING_MINUTES=120
POLICY_CLEANUP_UNFINISHED_MINUTES=60
# 요청 횟수 제한(사용자 IP별, WINDOW초 동안 LIMIT회): 끄기(false), 전체·방 만들기·입장·업로드
POLICY_THROTTLE_ENABLED=true
POLICY_THROTTLE_WINDOW_SECONDS=60
POLICY_THROTTLE_DEFAULT_LIMIT=600
POLICY_THROTTLE_CREATE_LIMIT=20
POLICY_THROTTLE_JOIN_LIMIT=60
POLICY_THROTTLE_UPLOAD_LIMIT=20
