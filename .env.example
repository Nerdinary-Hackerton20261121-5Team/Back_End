PORT=3000
# 콤마로 여러 개 지정 가능. 비워두면 모든 origin 허용
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
# true면 실행 SQL을 로그로 출력
DB_LOGGING=false

# NestJS Observe. `npx @nestjs/observe link` 가 .env 에 써 준다. 비어 있으면 텔레메트리를 보내지 않는다.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Observe 서비스 이름. 비우면 Hackathon_Back. 배포에서는 운영 be / dev 서버 be-dev 로 나눈다.
OBSERVE_SERVICE_ID=
