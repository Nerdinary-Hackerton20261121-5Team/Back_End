PORT=3000
# 콤마로 여러 개 지정 가능. 비워두면 모든 origin 허용
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
# true면 실행 SQL을 로그로 출력
DB_LOGGING=false

# 파일 저장소(S3 호환). 운영·dev 서버는 클러스터의 RustFS(http://s3:9000)를 쓰고 값은 클러스터가 주입한다.
# 로컬에서는 비워 두면 메모리 디스크로 대신한다(재시작하면 파일이 사라짐).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# RustFS·MinIO는 true, AWS S3는 false
S3_FORCE_PATH_STYLE=true

# 이미지 변환 서버 imgproxy. 운영 https://cmc-11th.bemelon.me/img, dev https://cmc-11th-dev.bemelon.me/img
IMGPROXY_URL=
# 서명 키·솔트(hex). 서버 값은 운영자 Secret storage-auth에만 있다
IMGPROXY_KEY=
IMGPROXY_SALT=
